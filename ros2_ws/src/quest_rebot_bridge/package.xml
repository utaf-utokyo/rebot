<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quest_rebot_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridges Meta Quest 3 controller input (via the isaacteleop/CloudXR SDK)
    to ROS 2, and (in later milestones) to reBot Arm B601-DM Cartesian
    teleoperation commands.
  </description>
  <maintainer email="kojumaru52@gmail.com">kojumaru</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rebotarm_bringup</exec_depend>
  <exec_depend>rebotarm_msgs</exec_depend>

  <!--
    controller_raw_publisher additionally needs isaacteleop and msgpack-numpy,
    pip-only packages with no rosdep key, in a venv (system site packages
    enabled) that also has rclpy visible (see docs/architecture.md, M0/M1).
    Not declared here since rosdep cannot resolve them. bridge_node.py (this
    package's other node) only needs plain msgpack (python3-msgpack, apt)
    plus the ROS deps above, so it runs under the system ROS 2 Python.
  -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
